# Copy to .env.local and adjust.

# WordPress that keeps serving the news posts and editable pages (headless CMS).
WP_URL=https://ichijoya.co.jp

# Public URL of this Next.js site (canonical / og:url / sitemap).
NEXT_PUBLIC_SITE_URL=https://ichijoya.co.jp

# Search engines: set to "true" only on the production deployment.
# Any other value adds <meta name="robots" content="noindex, nofollow"> to every page.
ALLOW_INDEXING=false

# Analytics (the live site uses GTM-5VPDRP2 and G-TX05WFFEQK). Leave empty in development
# so test traffic does not reach the production properties.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# Contact form delivery:
#   log  - validate and log only (default; nothing is sent anywhere)
#   cf7  - forward to the Contact Form 7 form on WP_URL (uses the mail settings configured in WordPress)
#   smtp - send with the SMTP settings below
CONTACT_MODE=log
CONTACT_CF7_FORM_ID=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
CONTACT_TO=
CONTACT_FROM=

# Optional: secret for POST /api/revalidate (call it from WordPress when a post is published).
REVALIDATE_SECRET=
